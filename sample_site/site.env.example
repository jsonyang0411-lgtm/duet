# Copy to site.env (docker compose) or /etc/sample_site.env (systemd); chmod 600.
# The admin token is best kept in its own file (see DEPLOY.md, section 3):
SAMPLE_SITE_ADMIN_TOKEN_FILE=/etc/sample_site/admin_token
# ...or, if you must, directly here (at least 32 random characters; empty = the site refuses to start):
SAMPLE_SITE_ADMIN_TOKEN=
SAMPLE_SITE_PUBLIC_URL=https://xuan.example.com
# SAMPLE_SITE_RETENTION_DAYS=90
# SAMPLE_SITE_BRAND=ACE7CN
