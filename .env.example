# === AI Backend: "claude", "deepseek", or "openai" ===
AI_BACKEND=deepseek

# === Claude / Anthropic (only needed if AI_BACKEND=claude) ===
ANTHROPIC_API_KEY=
# Anthropic API Base URL (可填兼容代理/中转服务)
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Model: claude-haiku-4-5-20251001 (fast/cheap) or claude-sonnet-4-5-20250929 (better quality)
SUMMARIZE_MODEL=claude-haiku-4-5-20251001
# Model for chat replies, proactive replies and memory consolidation (default: haiku).
# Kept separate so a stronger SUMMARIZE_MODEL does not make every chat reply pricier.
CLAUDE_CHAT_MODEL=claude-haiku-4-5-20251001

# === DeepSeek (only needed if AI_BACKEND=deepseek) ===
# 在此填入你的 DeepSeek API Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# DeepSeek API Base URL (可填 OpenAI-compatible 代理/中转服务)
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型: deepseek-v4-flash (推荐, 极速/极低价格) 或 deepseek-v4-pro (1M上下文, 旗舰)
DEEPSEEK_MODEL=deepseek-v4-flash

# === OpenAI (only needed if AI_BACKEND=openai) ===
OPENAI_API_KEY=
# 留空使用官方 API；可填兼容代理/中转服务
OPENAI_BASE_URL=
# 平衡成本/速度/质量的默认模型；需要更强质量可在控制台改
OPENAI_MODEL=gpt-5.6-terra
# 单独的看图超时；只在用户明确问图片/表情时使用
OPENAI_VISION_TIMEOUT_SEC=35
OPENAI_VISION_MAX_ATTEMPTS=1

# === Local model (a model on your own machine) ===
# MODEL_ROUTE decides which model does what:
#   cloud = everything on AI_BACKEND above (as before)
#   local = everything on the local model (no cloud key needed)
#   split = the LOCAL_TASKS groups on the local model, the rest on the cloud;
#           groups: chat (replies when called), proactive (proactive turns),
#           memory (memory extraction and the old diary). memory is the cheap
#           and private choice; proactive turns are the most frequent calls.
#           decide: with PIPELINE_V2=two_step, the "should I speak?" step for
#           unclear messages runs on the local model and the cloud model is
#           called only to write a reply (same replies, about half the cloud
#           calls in the evaluation; more in a busy group).
# The local server must speak the OpenAI API: Ollama (http://127.0.0.1:11434/v1),
# LM Studio (http://127.0.0.1:1234/v1), llama.cpp server or vLLM. Another
# computer on the network works too (Ollama there needs OLLAMA_HOST=0.0.0.0).
# For a 6 GB graphics card: Qwen3.5-4B (fits with room for context) or
# Qwen3.5-9B (tight). Avoid DeepSeek-R1 distills: they think before answering.
# The server's context window must hold about 8000 tokens (Ollama:
# OLLAMA_CONTEXT_LENGTH=8192), or the persona and rules are cut off.
# LOCAL_EXTRA_BODY is sent with every request, to switch thinking off. The
# default carries both fields: Ollama reads only reasoning_effort (it ignores
# chat_template_kwargs: a sum took 20 s of thinking), llama.cpp / vLLM read
# chat_template_kwargs.
#   Qwen without thinking answers better with its non-thinking sampling
#   (Ollama's default is the thinking one, temperature 1):
#   {"reasoning_effort": "none", "temperature": 0.7, "top_p": 0.8}
#   (fewer flawed replies from qwen3.5:4b)
#   empty = nothing extra. A <think> part in the answer is removed either way.
# Check the setup before running the bot: python tools/model_check.py
# --- Fully local (no cloud model at all), measured on qwen3.5:4b.
# Pull the models first:
#   ollama pull qwen3.5:4b ; ollama pull qwen3-embedding:0.6b
# then set (and check with python tools/model_check.py):
#   MODEL_ROUTE=local
#   LOCAL_MODEL=qwen3.5:4b
#   LOCAL_EXTRA_BODY={"reasoning_effort": "none", "chat_template_kwargs": {"enable_thinking": false}, "temperature": 0.7, "top_p": 0.8}
#   LOCAL_PROMPT=compact
#   PIPELINE_V2=two_step
#   MEMORY_V2=on
#   MEMORY_EMBEDDINGS=on
#   EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
#   EMBEDDING_MODEL=qwen3-embedding:0.6b
#   MEMORY_EMBEDDING_MIN_SIM=0.5
# Images go to the local model (OPENAI_VISION_MODEL is ignored for it); voice
# uses local Whisper; web search still needs the internet but no key.
MODEL_ROUTE=cloud
LOCAL_TASKS=memory
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL=
LOCAL_API_KEY=
LOCAL_TIMEOUT_SEC=90
LOCAL_MAX_TOKENS=2048
LOCAL_EXTRA_BODY={"reasoning_effort": "none", "chat_template_kwargs": {"enable_thinking": false}}
# The chat prompt for the local model: standard (the cloud model's) or compact
# (for a small model: empty memory/search sections left out, and "do what you
# are asked, do not make things up" where it reads it). Measured with
# evals/judge_replies.py.
LOCAL_PROMPT=standard
# When a cloud chat call fails (key out of quota, rate limited, unreachable):
# off = the reply fails as before; local = the local model (LOCAL_MODEL)
# answers instead, and the cloud is skipped for 3 minutes. Works with
# MODEL_ROUTE=cloud and split.
CLOUD_FALLBACK=off

# === WeChat 数据目录（可选，留空则自动检测）===
# 如果微信聊天记录不在默认路径（Documents\xwechat_files 或 Documents\WeChat Files），
# 请在此填写包含 wxid_* 文件夹的父目录绝对路径。
# 例如: D:\WeChatData 或 C:\Users\xxx\AppData\Roaming\Tencent\WeChat
WECHAT_DATA_DIR=

# === WeChat Backend ===
# Windows: wcdb. macOS: mac_hybrid (WeFlow WCDB read + Accessibility send) or mac_ui fallback.
WECHAT_BACKEND=wcdb
# Optional: override the detected macOS WeChat account data directory.
MAC_WEFLOW_DATA_DIR=
# macOS WeChat send shortcut: enter or cmd_enter.
MAC_WECHAT_SEND_SHORTCUT=enter
# Comma-separated group names. "*" = auto-discover all groups.
WECHAT_GROUPS=
# One-on-one private chats. Private chats reply without @mention.
PRIVATE_CHAT_ENABLED=false
# Comma-separated private chat display names/user IDs. "*" = auto-discover.
PRIVATE_CHATS=*

# === Bot Identity ===
# Your bot's WeChat display name. Used for @mention detection.
BOT_DISPLAY_NAME=群聊小助手

# === Conversational Persona ===
# 人设预设：yang_yujing（默认）是内置的杨宇靖，会逐条读取指定群的新消息；
# custom 是可编辑人设，只在被叫到时回复。
CHAT_PERSONA_PROFILE=yang_yujing
# 杨宇靖模式唯一启用逐条读取的群名；也可填 chatroom ID。
YANG_YUJING_GROUP_NAME=群主应该是pyc
# 杨宇靖模式下第二个逐条必回群；留空表示不启用。
YANG_YUJING_ALWAYS_REPLY_GROUP_NAME=
# 以下可编辑人设字段只在 CHAT_PERSONA_PROFILE=custom 时生效；不填时从杨宇靖的文字和数值开始
# （src/personas/yang_yujing.json）。多行文本用 literal \n 保存；也可在控制台「人设设置」编辑。
# CHAT_PERSONA_NAME=
# CHAT_PERSONA_PROMPT=
# CHAT_REPLY_RULES=
# CHAT_MAX_CHARS=30
# CHAT_CONTEXT_WINDOW_SEC=900
# CHAT_CONTEXT_COUNT=14

# === Trigger Keywords ===
# Comma-separated. The bot also responds to @mentions regardless of keywords.
TRIGGER_KEYWORDS=总结一下,之前发了什么,错过了什么,summarize,what did i miss,聊天总结,帮我总结,前面说了什么,说了啥,发生了什么

# === Database ===
DB_PATH=data/messages.db

# === Features ===

# 趣味功能 — @机器人抽签，返回随机运势签文（true/false）
FUN_ENABLED=true

# === Feishu Knowledge Base ===
# 开启后，@机器人说“同步到飞书”等触发词会自动创建/维护一个多维表格知识库。
FEISHU_EXPORT_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_EXPORT_MODE=knowledge
FEISHU_EXPORT_WINDOW_HOURS=8
FEISHU_EXPORT_TRIGGER_KEYWORDS=同步到飞书,导出到飞书,写到飞书,沉淀到飞书
# 开启后，最近窗口消息数达到阈值时会无感自动沉淀，不回群消息。
FEISHU_AUTO_SYNC_ENABLED=false
FEISHU_AUTO_SYNC_MIN_MESSAGES=20
FEISHU_AUTO_SYNC_COOLDOWN_SEC=1800
FEISHU_KNOWLEDGE_BASE_NAME=webot 群聊沉淀
# 可选：指定飞书文件夹 token；留空则使用应用默认创建位置。
FEISHU_KNOWLEDGE_FOLDER_TOKEN=

# === Tuning ===
# Seconds between message polls (default: 1.0, increase for lower CPU usage)
POLL_INTERVAL_SEC=1.0
# Minimum seconds between trigger responses in the same chat (dedup)
DEDUP_WINDOW_SEC=60
# Max messages to include in summary prompt.
# For groups with 999+ messages, increase this value.
# The bot uses token estimation + automatic chunking (map-reduce) to handle
# very large conversations safely within the model's context window.
MAX_MESSAGES_FOR_SUMMARY=5000
# Messages per chunk when map-reduce is triggered (default: 400)
CHUNK_SIZE=400
# If requester has no prior message, or the detected window is too small,
# expand to this many hours (minimum summary window)
FALLBACK_WINDOW_HOURS=8

# === Welcome New Member ===
# Master switch — automatically send a welcome message when a new
# member joins a group chat. Templates and per-group settings are
# stored in data/welcome_templates.json.
WELCOME_ENABLED=false

# === Proactive Participation ===
# Master switch — enable autonomous chat participation without @mention
PROACTIVE_ENABLED=false
# Rate calculation window in seconds (default: 120 = 2 minutes)
PROACTIVE_RATE_WINDOW_SEC=120
# Message rate thresholds (msgs/min) for each mode.
# Calibrate by running: python tools/analyze_chat_rhythm.py
PROACTIVE_RATE_QUIET=1.5
PROACTIVE_RATE_CASUAL=4.0
PROACTIVE_RATE_LIVELY=6.5
PROACTIVE_RATE_BURST=8.5
# Which gate decides the moment: "dice" rolls a per-mode probability,
# "score" uses a deterministic willingness score (a how-to question, a question
# nobody answered; reactions, echoes and having just spoken lower it) plus an
# hourly reply budget per group. Try "score" together with PIPELINE_V2.
PROACTIVE_GATE_MODE=dice
# score mode only: replies per group per hour (0 = no limit) and the score a
# message needs before the model is asked (0.05 - 0.95)
PROACTIVE_HOURLY_BUDGET=6
PROACTIVE_SCORE_THRESHOLD=0.35

# === Sticky Mention ===
# When a user sends @bot with no message text, the bot enters sticky
# listening mode.  The user's next message in the same group is treated
# as if it were @mentioned (one-shot — consumed on first non-empty follow-up).
# Set to false to disable entirely.
STICKY_MENTION_ENABLED=true
# Max seconds to wait for the follow-up message after an empty @mention
STICKY_MENTION_TTL_SEC=60

# === Follow-up Listener ===
# After the bot replies, briefly inspect short messages that look like they
# continue that reply.  Local rules filter candidates before any AI call.
FOLLOWUP_LISTEN_ENABLED=true
FOLLOWUP_LISTEN_TTL_SEC=60
FOLLOWUP_LISTEN_CONTEXT_COUNT=6
FOLLOWUP_LISTEN_MAX_MESSAGE_CHARS=30

# === Message Burst Coalescing ===
# Hold same-sender messages briefly so split WeChat bubbles become one turn.
MESSAGE_BURST_ENABLED=true
MESSAGE_BURST_WINDOW_SEC=2.2
MESSAGE_BURST_MAX_MESSAGES=5
MESSAGE_BURST_MAX_CHARS=200

# === Web Search ===
# Only triggered for explicit search/current-info messages such as 搜一下/查一下/最新.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=4
WEB_SEARCH_TIMEOUT_SEC=8.0
WEB_SEARCH_REGION=cn-zh
WEB_SEARCH_REPLY_MAX_CHARS=120

# === Image Understanding ===
# 用户明确问图时会识别；机器人刚回复某人后，该人 90 秒内发的首张图/表情包也会判断是否在接话。
IMAGE_VISION_ENABLED=true
IMAGE_VISION_LOOKBACK_SEC=900
IMAGE_VISION_MAX_BYTES=5242880
IMAGE_VISION_REPLY_MAX_CHARS=80
IMAGE_FOLLOWUP_ENABLED=true
IMAGE_FOLLOWUP_TTL_SEC=90
IMAGE_SCREEN_FALLBACK_ENABLED=true

# === Logging ===
LOG_LEVEL=INFO
# Optional log file (leave empty for console only)
LOG_FILE=data/bot.log

# === Observability (observe only — never changes bot behaviour) ===
# One JSON line per handled message: why the bot replied or stayed silent.
# Summarise with: python tools/trace_report.py
DECISION_TRACE_ENABLED=true
DECISION_TRACE_PATH=data/decision_trace.jsonl
# Characters of message text kept per record (0 = keep none)
DECISION_TRACE_CONTENT_CHARS=120
# One JSON line per chat / proactive model call: prompt, raw reply, cleaned reply.
LLM_CALL_LOG_ENABLED=true
LLM_CALL_LOG_PATH=data/llm_calls.jsonl
# false = keep only prompt fingerprints and lengths (no persona/memory/chat text)
LLM_CALL_LOG_PROMPTS=true

# === Structured pipeline (stage 2) ===
# off     = the original single prompt; blank means silence; regex clean-up
# single  = one call returns a JSON envelope: who the message is for, speak or
#           stay silent, and the message. Silence can no longer leak as text.
# two_step= like single, but unclear messages first get a short "should I
#           speak?" call and only a yes is followed by the reply call
# Roll it out on one group first and read
# the result with: python tools/trace_report.py
PIPELINE_V2=off
# One extra call when the model's answer is not a usable envelope
PIPELINE_REPAIR=true
# Use the provider's JSON mode when it has one (falls back by itself)
PIPELINE_JSON_MODE=true
# A reply longer than the persona's limit is sent back once to be rewritten
# shorter, instead of being cut at a sentence end (one more call, only then).
PIPELINE_REWRITE_LONG=off
# Further names that count as calling the bot (comma separated). The display
# name and the persona name always do. Only used when PIPELINE_V2 is on.
BOT_ALIASES=
# Which groups use the pipeline (and the scored gate): "*" = all, otherwise
# group names or chat ids, comma separated (substring match, like TODO_GROUPS).
# Add "private" to include one-to-one chats. Use it to try the pipeline in one
# group while every other group keeps the old behaviour.
PIPELINE_V2_GROUPS=*

# What the bot does after it answered someone. heuristic = listen for a short
# window with local rules (the old behaviour). declared = with PIPELINE_V2 the
# model says in its answer whom it waits for (the asker only / anyone / nobody).
FOLLOWUP_MODE=heuristic

# How a reply is delivered. SEND_BUBBLES=on: when the structured pipeline gives
# two messages (a reply to a mention or a proactive reply) they are sent as two
# chat bubbles instead of one joined line.
# SEND_TYPING_DELAY=on: wait a moment before each bubble, like someone typing
# (0.4 to 3.5 seconds depending on its length).
SEND_BUBBLES=off
SEND_TYPING_DELAY=off

# Quiet sending (Windows). Sending still types into WeChat, which needs its
# window in front for a moment; SEND_QUIET=on keeps that from getting in your way:
# - it waits until keyboard and mouse were idle for SEND_IDLE_SEC seconds
#   (0 = do not wait), at most SEND_IDLE_MAX_WAIT_SEC seconds, then sends anyway;
# - a group open in its own WeChat window (double-click it in the chat list) is
#   typed into directly, without the search in the main window. That window can
#   sit anywhere, even behind other windows; just do not close it;
# - afterwards the focus goes back to the window you were in, and with
#   SEND_KEEP_CLIPBOARD=on your clipboard is put back (the bot's text also stays
#   out of the Win+V clipboard history).
SEND_QUIET=off
SEND_IDLE_SEC=3
SEND_IDLE_MAX_WAIT_SEC=30
SEND_KEEP_CLIPBOARD=on

# SEND_QUEUE=on (Windows): one thread sends every reply. Without it a typing
# pause or the wait for you to pause before a send (SEND_QUIET) keeps a worker
# thread busy and, with all of them busy, no group gets an answer meanwhile. Recommended together
# with SEND_QUIET or SEND_TYPING_DELAY. A chat's replies stay in order; another
# chat's reply can go out during a typing pause.
SEND_QUEUE=off

# Emoji and stickers (they need PIPELINE_V2=single or two_step; otherwise they do nothing).
# WECHAT_EMOJI=on: the bot may now and then use WeChat's own emoji ("小黄脸"),
# written as codes such as [捂脸]. Only codes from the list survive, because
# WeChat shows an unknown code as plain text. WECHAT_EMOJI_CODES replaces the
# built-in list (e.g. 捂脸,旺柴,吃瓜). See which codes your WeChat knows with
#   python tools/sticker_check.py --emoji   (send the printed line to yourself)
# SEND_STICKERS=on: the bot may add a sticker picture from STICKER_DIR, at most
# once per STICKER_MIN_INTERVAL_SEC seconds in a chat. Set the folder up with
#   python tools/sticker_check.py --init    (then: python tools/sticker_check.py)
# Windows only; the Mac backends send the text and skip the sticker.
# STICKER_PASTE=file pastes the picture file (a GIF can stay animated);
# image pastes a still picture, for a WeChat that sends pasted files as attachments.
WECHAT_EMOJI=off
WECHAT_EMOJI_CODES=
SEND_STICKERS=off
STICKER_DIR=data/stickers
STICKER_MIN_INTERVAL_SEC=600
STICKER_PASTE=file

# Personas: a persona is a JSON file (src/personas/yang_yujing.json for the
# built-in one; put your own in data/personas/). data/persona_map.json then chooses one
# per group, e.g. {"groups": {"读书群": "bookworm"}, "private": "bookworm"}.
# Without that file the persona configured above speaks everywhere.

# Example dialogues (structured pipeline only): put real short exchanges of a
# persona in data/examples/<persona id or name>.txt, e.g. data/examples/yang_yujing.txt:
#   群友：鸣潮新角色你抽了吗
#   杨宇靖：没抽，等复刻
#   ---
#   群友：晚饭吃啥
#   杨宇靖：食堂，懒得出去
# For each reply the PERSONA_EXAMPLES closest ones (0 = none) are shown to the
# model as a style reference; other speakers appear as 群友. The file is re-read
# when it changes. Draft one from the chat history (the member's consent first):
#   python tools/persona_examples.py extract --speaker <member> --as <persona> --out data/examples/<id>.txt
# and check it with: python tools/persona_examples.py check <file> --persona <name>
PERSONA_EXAMPLES=4
PERSONA_EXAMPLES_DIR=data/examples

# === Memory v2 ===
# off = the old overwritten diary and LIKE history search, unchanged.
# on  = a background job reads the chat in windows, asks the model for facts
#       (nicknames, preferences, plans, in-jokes) and a short summary, and keeps
#       only what it can prove with a quote from a real message. Replies then
#       carry the facts that concern the people talking, and recall questions
#       ("what did X say about ...") search old messages with FTS5.
# Costs one cheap JSON call per window (roughly 3-6k input tokens). Try it in one
# group first and read the result with: python tools/memory_admin.py facts --chat <id>
MEMORY_V2=off
# Which groups use it: "*" = all, otherwise group names or chat ids (comma
# separated, substring match). Add "private" for one-to-one chats.
MEMORY_V2_GROUPS=*
# A window runs after this many new messages ...
MEMORY_WINDOW_MESSAGES=40
# ... or after this many quiet minutes if at least 8 messages are waiting
MEMORY_IDLE_MINUTES=20
# Facts below this confidence are never put in a prompt
MEMORY_MIN_CONFIDENCE=0.6
# Most facts put into one prompt
MEMORY_PROMPT_FACTS=12
# Meaning-based search for memory v2 facts: "我不能吃虾" also finds "对海鲜过敏".
# Needs an OpenAI-compatible embeddings endpoint, e.g.
#   SiliconFlow: EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1  EMBEDDING_MODEL=BAAI/bge-m3
#   OpenAI:      EMBEDDING_BASE_URL=https://api.openai.com/v1      EMBEDDING_MODEL=text-embedding-3-small
# Fact texts and messages addressed to the bot are sent to that endpoint.
# A local server without a key: set EMBEDDING_BASE_URL and EMBEDDING_MODEL only.
# MEMORY_EMBEDDING_MIN_SIM: a fact at least this close is used (model-dependent;
# raise it if unrelated facts show up, lower it if related ones are missed).
MEMORY_EMBEDDINGS=off
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
MEMORY_EMBEDDING_MIN_SIM=0.55

# === Claude relay (Windows bot -> Claude Code on a Mac) ===
# CLAUDE_RELAY=on: a private message that starts with CLAUDE_RELAY_PREFIX ("cc 跑一下测试")
# from CLAUDE_RELAY_WXIDS (comma-separated wxids; empty = ADMIN_WXID) is queued for
# the Mac. The Mac runs tools/claude_relay/worker.py, which asks this bot for jobs on
# CLAUDE_RELAY_HOST:CLAUDE_RELAY_PORT, runs Claude Code and sends the result back;
# the bot answers at once with a receipt and sends the result when it arrives.
# Needs PRIVATE_CHAT_ENABLED=true (PRIVATE_CHATS can be just your own chat).
# "cc 帮助" lists the commands (状态 / 取消 / 重试 / 新对话 / @项目).
# CLAUDE_RELAY_TOKEN: a long random secret, the same on the Mac (RELAY_TOKEN). Make one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Anyone who can reach the port with the token can make the Mac run commands: allow the
# port only from your LAN in the Windows firewall (see tools/claude_relay/README.md).
CLAUDE_RELAY=off
CLAUDE_RELAY_TOKEN=
CLAUDE_RELAY_HOST=0.0.0.0
CLAUDE_RELAY_PORT=8790
CLAUDE_RELAY_PREFIX=cc
CLAUDE_RELAY_WXIDS=
# CLAUDE_RELAY_ONLY=on: the bot is a relay and nothing else. Messages that are not cc requests
# are stored but not answered (no group mentions, no other private chats, no proactive lines,
# no welcome, no memory job, no model call). No AI key is needed: the start-up check for
# DEEPSEEK/OPENAI/ANTHROPIC keys is skipped and no model is created. Needs CLAUDE_RELAY=on.
CLAUDE_RELAY_ONLY=off
# Results longer than this are cut in WeChat (the Mac keeps the full text)
CLAUDE_RELAY_MAX_CHARS=1500
# CLAUDE_RELAY_LONG_FILE=on: such a result goes as a .txt file (data/claude_relay_files/),
# followed by a message with its start. Only backends that can send files (Windows wcdb);
# elsewhere it is cut as above.
CLAUDE_RELAY_LONG_FILE=on
# A job that waited in the queue gets "#3 开始了"; a long one gets "#3 进行中（6分钟）：第 14 步 ·
# 改 service.py" every this many minutes (what Claude is doing, sent by the Mac). 0 = off.
CLAUDE_RELAY_PROGRESS_MIN=3

# === OCR fallback (macOS mac_hybrid and Windows wcdb backends) ===
# OCR_FALLBACK=on: while the WeChat database cannot be read (macOS: WeFlow not running, key no
# longer valid; Windows: the DLL cannot be loaded or the database cannot be opened), the bot reads
# the OPEN group chat from a picture of the WeChat window with the system's own OCR (Apple Vision /
# Windows.Media.Ocr) and answers as usual; when the database works again it switches back, and what
# the database returns for the gap is not answered. Sending is unchanged. On Windows the bot even
# starts when the database cannot be opened (name the groups in WECHAT_GROUPS; "*" needs the database).
# Limits: only the chat that is open and only the part shown; the speaker of a line is unknown, so
# only @-mentions and name calls trigger (no per-person logic, no admin commands, no cc relay);
# no pictures/voice/stickers; WeChat must not be minimized. It reads the FRONT WeChat window (the main
# window or an independent chat window): keep that window large (about 600x500 or more).
# macOS: Screen Recording permission for the program that runs the bot, Xcode Command Line Tools
#        (the recognizer is compiled once with swiftc).
# Windows: the Chinese OCR language pack, once, in PowerShell as administrator:
#        Add-WindowsCapability -Online -Name Language.OCR~~~zh-CN~0.0.1.0
# Check this computer first: python tools/ocr_check.py   (numbers only; --help for the rest)
# Also a switch in the console (Advanced > 读取备选（OCR）). Restart the bot after changing it.
OCR_FALLBACK=off
# Database reads that must fail in a row before OCR takes over (one read per second)
OCR_FALLBACK_AFTER=3
# Seconds between two looks at the screen (a look takes about 0.8 s)
OCR_POLL_SEC=4
