# webot: a business WeChat account's gateway.
# - "cc ..." in an allowed person's private chat goes to Claude Code on a Mac (CLAUDE_RELAY);
# - a registered creator's private messages become drafts the console approves (PRM_COPILOT),
#   or events for the Mac business service (PRM_EDGE);
# - the admin's account commands (查状态, 添加好友, 自动同意好友) in a private chat.
# There is no chat model and no AI key: every group message and every other private message is
# stored and never answered.

# === WeChat 数据目录（可选，留空则自动检测）===
# 如果微信聊天记录不在默认路径（Documents\xwechat_files 或 Documents\WeChat Files），
# 请在此填写包含 wxid_* 文件夹的父目录绝对路径。
# 例如: D:\WeChatData 或 C:\Users\xxx\AppData\Roaming\Tencent\WeChat
WECHAT_DATA_DIR=

# === WeChat Backend ===
# Windows: wcdb. macOS: mac_hybrid (WeFlow WCDB read + Accessibility send) or mac_ui fallback.
WECHAT_BACKEND=wcdb
# Optional: override the detected macOS WeChat account data directory.
MAC_WEFLOW_DATA_DIR=
# macOS WeChat send shortcut: enter or cmd_enter.
MAC_WECHAT_SEND_SHORTCUT=enter
# Comma-separated group names to read. "*" = all groups. Group messages are only recorded,
# never answered; the backend needs at least one group to start (a test group is enough).
WECHAT_GROUPS=
# Read one-on-one chats: the relay's cc tasks, the creators, the admin's commands.
PRIVATE_CHAT_ENABLED=false
# Comma-separated private chat display names/user IDs. "*" = auto-discover. Registered
# creators are read without being listed here.
PRIVATE_CHATS=*

# === Account ===
# This account's WeChat display name (its own lines are skipped).
BOT_DISPLAY_NAME=群聊小助手
# The admin's wxid: the account commands, and the relay's user when CLAUDE_RELAY_WXIDS is empty.
ADMIN_WXID=

# === Database ===
DB_PATH=data/messages.db

# === Tuning ===
# Seconds between message polls (default: 1.0, increase for lower CPU usage)
POLL_INTERVAL_SEC=1.0

# === Message Burst Coalescing ===
# Hold same-sender messages briefly so split WeChat bubbles become one turn.
MESSAGE_BURST_ENABLED=true
MESSAGE_BURST_WINDOW_SEC=2.2
MESSAGE_BURST_MAX_MESSAGES=5
MESSAGE_BURST_MAX_CHARS=200

# === Pictures forwarded by the relay ===
# How far back (seconds) a picture's file is looked for, and the largest one (bytes).
IMAGE_VISION_LOOKBACK_SEC=900
IMAGE_VISION_MAX_BYTES=5242880

# === Logging ===
LOG_LEVEL=INFO
# Optional log file (leave empty for console only)
LOG_FILE=data/bot.log

# === Observability (observe only — never changes bot behaviour) ===
# One JSON line per handled message: why the bot replied or stayed silent.
# Summarise with: python tools/trace_report.py
DECISION_TRACE_ENABLED=true
DECISION_TRACE_PATH=data/decision_trace.jsonl
# Characters of message text kept per record (0 = keep none; a registered creator's text is never kept)
DECISION_TRACE_CONTENT_CHARS=120

# === Sending ===
# SEND_TYPING_DELAY=on: wait a moment before each message, like someone typing
# (0.4 to 3.5 seconds depending on its length).
SEND_TYPING_DELAY=off

# Quiet sending (Windows). Sending still types into WeChat, which needs its
# window in front for a moment; SEND_QUIET=on keeps that from getting in your way:
# - it waits until keyboard and mouse were idle for SEND_IDLE_SEC seconds
#   (0 = do not wait), at most SEND_IDLE_MAX_WAIT_SEC seconds, then sends anyway;
# - a chat open in its own WeChat window (double-click it in the chat list) is
#   typed into directly, without the search in the main window. That window can
#   sit anywhere, even behind other windows; just do not close it;
# - afterwards the focus goes back to the window you were in, and with
#   SEND_KEEP_CLIPBOARD=on your clipboard is put back (the bot's text also stays
#   out of the Win+V clipboard history).
SEND_QUIET=off
SEND_IDLE_SEC=3
SEND_IDLE_MAX_WAIT_SEC=30
SEND_KEEP_CLIPBOARD=on

# SEND_QUEUE=on (Windows): one thread sends every message. Without it a typing
# pause or the wait for you to pause before a send (SEND_QUIET) keeps a worker
# thread busy and, with all of them busy, no other message is handled meanwhile.
# Recommended together with SEND_QUIET or SEND_TYPING_DELAY. A chat's messages
# stay in order; another chat's message can go out during a typing pause.
SEND_QUEUE=off

# SEND_VERIFY_CHAT=on (Windows): a send types the chat's name into WeChat's search and opens the first
# result, and WeChat 4 cannot be asked which chat that is. With this on, the chat title is read from the
# screen (Windows OCR, about a second per send) before anything is pasted: when it is another chat the bot
# knows of (a name inside another one: "Amy" and the contact "Amy陈" or the group "Amy粉丝群"), or a group
# while a private chat was asked for, nothing is pasted and the send fails with the reason. A title it
# cannot read or judge changes nothing (sent as before); without the Chinese OCR language it is skipped.
SEND_VERIFY_CHAT=on

# How a picture or file is pasted (Windows): file pastes the file (a GIF can stay
# animated); image pastes a still picture, for a WeChat that sends pasted files as attachments.
STICKER_PASTE=file

# === Claude relay (Windows bot -> Claude Code on a Mac) ===
# CLAUDE_RELAY=on: a private message that starts with CLAUDE_RELAY_PREFIX ("cc 跑一下测试")
# from CLAUDE_RELAY_WXIDS (comma-separated wxids; empty = ADMIN_WXID) is queued for
# the Mac. The Mac runs tools/claude_relay/worker.py, which asks this bot for jobs on
# CLAUDE_RELAY_HOST:CLAUDE_RELAY_PORT, runs Claude Code and sends the result back;
# the bot answers at once with a receipt and sends the result when it arrives.
# Needs PRIVATE_CHAT_ENABLED=true (PRIVATE_CHATS can be just your own chat).
# "cc 帮助" lists the commands (状态 / 取消 / 重试 / 新对话 / @项目).
# CLAUDE_RELAY_TOKEN: a long random secret, the same on the Mac (RELAY_TOKEN). Make one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Anyone who can reach the port with the token can make the Mac run commands: allow the
# port only from your LAN in the Windows firewall (see tools/claude_relay/README.md).
CLAUDE_RELAY=off
CLAUDE_RELAY_TOKEN=
CLAUDE_RELAY_HOST=0.0.0.0
CLAUDE_RELAY_PORT=8790
CLAUDE_RELAY_PREFIX=cc
CLAUDE_RELAY_WXIDS=
# CLAUDE_RELAY_ONLY=on: every private message of an allowed person is a task, "cc" may be left
# out (the admin's account commands such as 添加好友 / 查状态 stay commands). Needs CLAUDE_RELAY=on.
# Either way, groups and everybody else's private chats are never answered.
CLAUDE_RELAY_ONLY=off
# Results longer than this are cut in WeChat (the Mac keeps the full text)
CLAUDE_RELAY_MAX_CHARS=1500
# CLAUDE_RELAY_LONG_FILE=on: such a result goes as a .txt file (data/claude_relay_files/),
# followed by a message with its start. Only backends that can send files (Windows wcdb);
# elsewhere it is cut as above.
CLAUDE_RELAY_LONG_FILE=on
# A job that waited in the queue gets "#3 开始了"; a long one gets "#3 进行中（6分钟）：第 14 步 ·
# 改 service.py" every this many minutes (what Claude is doing, sent by the Mac). 0 = off.
CLAUDE_RELAY_PROGRESS_MIN=3

# === PRM copilot (drafted replies for registered creators) ===
# PRM_COPILOT=on: the private messages of the creators registered in the console (合作单 page)
# are not answered at all; they go, silently, to the Mac as "prm" jobs of the relay. The Mac
# worker drafts a reply in its locked-down prm_workspace (knowledge base kb/, case files
# deals/, material assets/; no commands, no web, nothing outside that folder) and the draft
# waits in the console (待审批) until an operator sends, edits or drops it. Phone and ID
# numbers become placeholders before anything leaves this PC. Needs CLAUDE_RELAY=on and
# PRIVATE_CHAT_ENABLED=true (the creators' private chats are read even when they are not in
# PRIVATE_CHATS; Windows wcdb backend). The Mac must set prm_workspace in its config.json.
PRM_COPILOT=off
PRM_DB=data/prm.db
# PRM_AUTO_REGISTER=on: every new friend of this account (we added her, she added us, the bot
# accepted her request) is registered as a creator by the bot, as if an operator had clicked 登记:
# her messages since she was added become one draft that waits for a person, her later drafts go
# through the gates and the night window like any creator's. Never the admin or a cc user, never
# someone who has a party already (an operator's 停用 sticks). Customers, couriers and colleagues
# get drafts too: 停用 in the 合作单 page removes one. Windows copilot mode only (not PRM_EDGE);
# needs a bot restart. off = registering is a person's click, as before.
PRM_AUTO_REGISTER=off
# PRM_WECHAT_REVIEW=on (微信里审批草稿): every draft that waits in 待审批 is also sent once, as one
# message, to the admin's private chat (ADMIN_WXID must be set), and the admin answers there from
# the phone: quote it and reply 1 (send) / 2 (don't) / 改 <your words> (send those instead), or
# 发 12 / 不发 12 / 改 12 <your words>; a bare 1 / 2 answers the last thing the bot said there (never
# with CLAUDE_RELAY_ONLY). The same decision as the console's. Never for drafts that go out by
# themselves, 百应 drafts or holding replies; on the first switch-on only the last 12 hours' drafts
# are sent; a platform action is only run from the console. Windows copilot mode only; needs a bot
# restart. off = the console only, as before.
PRM_WECHAT_REVIEW=off
# An operator replying to a creator by hand from this WeChat account (phone or PC) takes the
# chat over for this many minutes (5-1440): the creator's messages are only recorded, and the
# next draft after it is told what both sides said. The console can end it earlier.
PRM_TAKEOVER_MIN=120
# A draft left this many minutes in 待审批 gets one holding reply to the creator per round of
# their messages (0 = never, up to 120); the draft keeps waiting.
PRM_HOLDING_MIN=10
PRM_HOLDING_TEXT=收到，我确认一下马上回您
# This many days after a deal is delivered (1-365), its receiving details are cleared everywhere:
# phone/ID numbers keep only their masked form, addresses only the province and city (also in
# the chat archive, the relay jobs and the Mac's case file).
PRM_RETENTION_DAYS=30
# When a sample order's products get their 专属佣金 drafted (still approved by a person):
# delivered = after the creator signed for the sample (the deal marked 已签收), created = as soon
# as the order is made in 聚水潭.
PRM_COMMISSION_AFTER=delivered
# Messages that came in while the bot was not reading WeChat (stopped, the EXE being updated,
# the database re-opened after read errors): after a restart the creators' messages the bot
# never handled are handed on (only those newer than the last one it stored for that chat,
# never twice). One up to this many hours old (0-72) is drafted as usual, but its draft always
# waits in 待审批 and the deal says these came in while the bot was not reading; an older one is
# only recorded (the deal's history, the next draft hears of it) and the deal asks a person to
# look. The account's own lines from that time (typed on the phone) are recorded too; only a
# recent one still takes the chat over. 0 = the old rule: anything older than 5 minutes is
# history and is dropped.
PRM_CATCHUP_HOURS=12
# Where the sample orders the bot made stand in 聚水潭: every PRM_SAMPLE_SYNC_MIN minutes (10-1440,
# 0 = off) the orders verified and not signed for nor deleted go to the Mac in one job (the worker runs
# jushuitan-engineering's read-only `jst samples`, no model, no receiver details; the platform CLI lock,
# a pause between calls). A waybill the deal has none of is filled in like the console's 填运单号 (the
# shipping notice always waits in 待审批); 已签收 marks the deal like the console's (the 专属佣金 drafts
# start; a person's deal or a creator off the list: the step waits, as ever). A deleted or rejected
# order, a waybill an operator typed that 聚水潭 does not have, not sent PRM_SAMPLE_WAYBILL_DAYS
# (1-30) after the order was made, not signed for PRM_SAMPLE_SIGN_DAYS (1-60) after it was sent, a
# lapsed 聚水潭 login: the deal says so (合作单 page). 聚水潭's sample list gives no waybill as yet
# (checked 2026-10-29): an order it says went out asks the operator to type the waybill in.
# Needs the Mac's config.json platforms.jst.
PRM_SAMPLE_SYNC_MIN=60
PRM_SAMPLE_WAYBILL_DAYS=3
PRM_SAMPLE_SIGN_DAYS=10
# 签收后问一句 (2026-11-07): when that sync sees a sample order signed for (the bot's own, or one of ours made by
# hand whose waybill went into her deal) and nobody marked her deal 已签收 first, one draft asks her whether the
# samples came and suit her (kb 场景 D2「聚水潭显示签收」; the Mac writes nothing when she already said so). Once per
# order; only inside PRM_SIGNED_HELLO_HOURS by this PC's clock (HH:MM-HH:MM, empty = 10:00-20:00; a signature
# outside waits for them); none when she wrote after the signature or it is 3 days old; it waits while she is off
# the list, a person has the chat, or a draft of hers is being written or waits in 待审批. By day the draft always
# waits in 待审批, even when its kind's gate is auto; in the night window or 自动模式 the night's rules judge it
# like a reply draft's. off (the default): nothing of it.
PRM_SIGNED_HELLO=off
PRM_SIGNED_HELLO_HOURS=10:00-20:00
# 抖音百应 private messages (精选联盟私信): creators invited by 邀约带货 may answer there, not in WeChat. Every
# PRM_BUYIN_SYNC_MIN minutes (5-1440, 0 = off, the default) the Mac reads the new ones (douyin-engineering's
# read-only `dy buyin im-inbox` in its main since 2026-10-30, no model; the platform CLI lock; it reads the 百应
# 「精选联盟私信」 page open in the Mac's debug Chrome; contract in tools/claude_relay/README.md; an older douyin
# checkout without the command: the 待审批 page says 百应私信读不了 once an interval). A registered
# creator (matched by the 达人名单's 抖音号 / 平台 UID, or the ids her verified 抖店 sample orders found; never by
# nickname) gets a 百应 draft in 待审批: an operator copies it (复制 / 改了再复制, written down like 显示完整号码), sends it
# in 百应 by hand and clicks 已在百应发了. The bot never sends it anywhere (no WeChat 稍等, no gate, no platform action,
# no files). Nobody on the list: no party is made, the page only says how many wrote. While a person has the deal
# (人工接管 / 暂停) her 百应 lines are only recorded. Needs the Mac's config.json platforms.dy.
PRM_BUYIN_SYNC_MIN=0
# 加百应达人微信 (off by default; CODEBASE_REFERENCE 功能 R): a creator invited by a 百应 邀约卡 left her 微信号 / 手机号.
# With PRM_FRIEND_ADD=on an operator types it into the console (合作单 › 手动登记百应达人留的联系方式), checks it in
# 待审批 › 加微信 and clicks 「添加该达人微信」 (or the admin says 加达人 <编号>): the bot sends ONE friend request through
# the friend manager (the same add as the admin's 添加好友; Windows WeChat window), never again by itself. WeChat's
# risk prompt (「操作过于频繁」) pauses the auto-accept too and every add waits until the admin says 自动同意好友 开.
# When she accepted, an operator clicks 「是她，登记并关联」: she is registered with her 抖音号. Her full number is kept
# only for the add, cleared when she is linked or dropped, 14 days after a request she did not accept, 7 days after
# nobody touched it, 30 days at most; everywhere else it is masked.
PRM_FRIEND_ADD=off
# At most this many adds a day from the console and 加达人 (1-30), and this many seconds between two (30-3600)
PRM_FRIEND_ADD_DAILY_MAX=10
PRM_FRIEND_ADD_GAP_SEC=120
# The greeting (at most 30 characters once filled in; the operator can change it before adding): {品牌} =
# PRM_FRIEND_ADD_BRAND (without a brand 「我是{品牌}，」 is left out); {昵称} = her 百应 nickname (its first 8
# characters), not in the default since 2026-11-03 (just 「您好」; her remark tells her apart once she accepts).
PRM_FRIEND_ADD_GREETING=您好，我是{品牌}，百应上联系您的～
# Your brand's name for the greeting: only in this PC's .env, never in the code repository (at most 20 characters)
PRM_FRIEND_ADD_BRAND=
# The remark (备注) she gets in our WeChat when the bot adds her: {昵称} = her 百应 nickname (her 抖音号 when she has
# none or it holds a number), at most 16 characters once filled in, "-<last 4 of her 抖音号>" after it when another
# record has the same one; at most 10 characters besides {昵称}. The bot types it only when OCR finds the 「备注」 field
# of WeChat 4.0's application window (otherwise the request goes without it). Empty (PRM_FRIEND_ADD_REMARK=) = no remark.
PRM_FRIEND_ADD_REMARK=抖音-{昵称}

# === WeChat edge for the Mac business service (src/edge, edge-protocol.md) ===
# PRM_EDGE=on: this PC only receives and sends WeChat messages for the creators the Mac
# lists (PUT /edge/parties): their private messages (pictures decoded, voice as text) become
# events the Mac pulls from /edge/* on the relay's port, never answered or stored here; the
# Mac's send requests go out once each, are read back, and an operator's own replies in
# those chats are reported. Needs CLAUDE_RELAY=on and PRIVATE_CHAT_ENABLED=true; not together
# with PRM_COPILOT. PRM_EDGE_TOKEN: at least 32 characters, not the CLAUDE_RELAY_TOKEN.
PRM_EDGE=off
PRM_EDGE_TOKEN=
EDGE_DB=data/edge.db
# Pace of the edge's sends (EDGE_SEND_MIN_GAP_SEC 0-60 between two, EDGE_SEND_PER_HOUR 1-1000).
EDGE_SEND_MIN_GAP_SEC=3
EDGE_SEND_PER_HOUR=60
# A sent text (a files-only send) not read back from WeChat within this many seconds is
# reported unseen (60-86400).
EDGE_SEEN_TEXT_SEC=1800
EDGE_SEEN_FILE_SEC=600
# Events and their files are deleted this many days after the Mac acknowledged them (1-30).
EDGE_KEEP_DAYS=7

# ── Mac 端：通过 Windows 的微信边缘收发（WECHAT_BACKEND=edge）────────────
# 这台 Mac 不登录微信，Windows（PRM_EDGE=on）替它收发。设 WECHAT_BACKEND=edge，
# EDGE_URL 填 Windows 的地址，PRM_EDGE_TOKEN 填和 Windows 上一样的口令。Mac 上不要开 PRM_EDGE。
# EDGE_URL=http://192.168.1.20:8790
#
# 起草（同事的 PRM 副驾驶搬到 Mac）：中转只给本机的起草 worker 用，必须只监听 127.0.0.1。
#   CLAUDE_RELAY=on
#   CLAUDE_RELAY_HOST=127.0.0.1
#   CLAUDE_RELAY_TOKEN=<随机 32 位以上，和 PRM_EDGE_TOKEN 不同；worker 的 ~/.claude-relay/token 里写同一个>
#   PRM_COPILOT=on
# worker：~/.claude-relay/config.json 里 relay_url 写 http://127.0.0.1:8790，prm_workspace 写一个单独的业务资料
# 目录（不在代码仓库里，模板在 tools/claude_relay/prm_workspace_template），然后在终端里运行
#   /usr/bin/python3 tools/claude_relay/worker.py --kinds prm
# 代理只写在 ~/.zshrc 里的话，双击 start-prm-worker.command 启动的 worker 拿不到代理（claude 会 403），
# 要么从终端启动，要么把代理写进 ~/.claude/settings.json 的 env（worker 会转给受限模式的 claude）。

# === OCR fallback (macOS mac_hybrid and Windows wcdb backends) ===
# OCR_FALLBACK=on: while the WeChat database cannot be read (macOS: WeFlow not running, key no
# longer valid; Windows: the DLL cannot be loaded or the database cannot be opened), the bot reads
# the OPEN group chat from a picture of the WeChat window with the system's own OCR (Apple Vision /
# Windows.Media.Ocr); when the database works again it switches back. On Windows the bot even
# starts when the database cannot be opened (name the groups in WECHAT_GROUPS; "*" needs the database).
# Limits: only the group chat that is open and only the part shown; the speaker of a line is
# unknown. Lines read this way are only recorded (groups are never answered; no admin command,
# no cc relay, no creator message comes from OCR); no pictures/voice/stickers; WeChat must not be
# minimized. It reads the FRONT WeChat window (the main
# window or an independent chat window): keep that window large (about 600x500 or more).
# macOS: Screen Recording permission for the program that runs the bot, Xcode Command Line Tools
#        (the recognizer is compiled once with swiftc).
# Windows: the Chinese OCR language pack, once, in PowerShell as administrator:
#        Add-WindowsCapability -Online -Name Language.OCR~~~zh-CN~0.0.1.0
# Check this computer first: python tools/ocr_check.py   (numbers only; --help for the rest)
# Also a switch in the console (Advanced > 读取备选（OCR）). Restart the bot after changing it.
OCR_FALLBACK=off
# Database reads that must fail in a row before OCR takes over (one read per second)
OCR_FALLBACK_AFTER=3
# Seconds between two looks at the screen (a look takes about 0.8 s)
OCR_POLL_SEC=4

# === Friend management (Windows wcdb backend only) ===
# The admin (ADMIN_WXID) can say, in a private chat with this account: 查状态, 添加好友 <wxid or phone>
# [greeting], 同意好友, 自动同意好友 开/关, 帮助.
# 查状态 answers with the WeChat connection, the switches and the message count (any backend).
# The friend commands drive the WeChat window (keyboard, mouse, OCR; needs the Windows OCR, see
# tools/ocr_check.py), take the screen for a few seconds and share the window lock with the sends. Nothing is clicked unless WeChat is in
# front and the button was read on the screen. Check by hand first: python tools/friend_admin.py --status
# What to try on a real Windows machine: friend-management-test.md
# AUTO_ACCEPT_FRIENDS=on: the bot accepts the pending requests of "新的朋友" (at most 10 per check). Off by default
# because it takes the screen; the commands work either way. It must not get in the way of the person at the
# computer, so every AUTO_ACCEPT_INTERVAL_SEC seconds it first LOOKS, silently (a picture of the window; nothing is
# brought forward, clicked or typed), for a NEW red badge in WeChat's left rail, and does nothing if there is none.
# Only when something may be waiting does it take the screen, and then only after you have paused (below); the
# focus goes back to the window you were in.
AUTO_ACCEPT_FRIENDS=off
# Seconds between two looks (10-86400); the first one comes one interval after the start. A look is cheap, so
# 30-60 is fine when AUTO_ACCEPT_WATCH=on
AUTO_ACCEPT_INTERVAL_SEC=300
# on: look for a new red badge first (above). off: every interval is a full check (still waits for you to pause)
AUTO_ACCEPT_WATCH=on
# A check that takes the screen waits until keyboard and mouse have been still this many seconds (0 = do not wait)
AUTO_ACCEPT_IDLE_SEC=60
# A full check is forced this often even without a new badge, in case a badge is not recognised (0 = never; 60-86400)
AUTO_ACCEPT_FULL_CHECK_SEC=900
# At most this many requests are accepted automatically a day (this computer's calendar day; 1-300). WeChat
# holds back accounts that take on friends in bulk (「操作过于频繁」, then days without adding friends), so the
# default is a conservative 50: a normal day of creators asking; past it the bot rests until tomorrow and tells
# the admin (ADMIN_WXID) once. The admin's 同意好友 is not counted against it. When WeChat shows a risk prompt
# (「操作过于频繁，请稍后再试」 and the like), or a request stays pending three checks in a row, auto-accept pauses
# and tells the admin; it stays paused (also across restarts) until the admin says 自动同意好友 开.
# Kept in data/auto_accept_state.json.
AUTO_ACCEPT_DAILY_MAX=50
